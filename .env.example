# Supabase (you have: URL + service_role). Still need DATABASE_URL from Database → Connection string.
SUPABASE_URL=https://wbdwnlzbgugewtmvahwg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
# From Supabase → Connect → Connection string → URI → Direct. Replace [YOUR-PASSWORD] with your DB password.
# If Direct fails (e.g. IPv4-only network), use the Session pooler URI from the same page instead.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.wbdwnlzbgugewtmvahwg.supabase.co:5432/postgres

# Auth: required for private search (GET /search). Supabase → Settings → API → JWT secret.
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>
# Optional: enable Auth providers via script. Create at https://supabase.com/dashboard/account/tokens
# SUPABASE_MANAGEMENT_TOKEN=
# GOOGLE_CLIENT_ID=   GOOGLE_CLIENT_SECRET=   (for enable_supabase_auth.py)

# YouTube
YOUTUBE_API_KEY=<your-youtube-api-key>

# Transcription
DEEPGRAM_API_KEY=<your-deepgram-key>

# LLM – Anthropic for Operators Vault
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: deployment and extras (you have these; add if using)
RAILWAY_API_TOKEN=
# RAILWAY_PROJECT_ID=
# PINECONE_API_KEY=
# PINECONE_INDEX=
# PINECONE_ENVIRONMENT=us-east-1

# n8n (base URL without /signin for API)
N8N_HOST=https://entagency.app.n8n.cloud
N8N_API_KEY=<your-n8n-jwt>

# Optional: embeddings, semantic search, vault+web, SEO
# OPENAI_API_KEY=
# DATA_FOR_SEO_API_KEY=
# PERPLEXITY_API_KEY=
# SERPAPI_API_KEY=

# Firecrawl (web scraping)
# FIRECRAWL_API_KEY=
